# Independent MySQL test schema. Verify/Test use .env.java-test by default.
LIVECUT_DB_URL=jdbc:mysql://127.0.0.1:13306/livecut_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LIVECUT_DB_USER=livecut
LIVECUT_DB_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
LIVECUT_STORAGE_ROOT=../data/test-storage
LIVECUT_WORKER_API_KEY=REPLACE_WITH_TEST_ONLY_WORKER_KEY
LIVECUT_API_PORT=0
