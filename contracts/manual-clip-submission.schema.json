{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livecut:manual-clip-submission:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "operation",
    "job_id",
    "plan_id",
    "idempotency_key",
    "input",
    "request_hash",
    "revision",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_kind": {
      "const": "manual_clip_submission"
    },
    "operation": {
      "enum": [
        "CREATE",
        "REVISION"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_fingerprint",
            "title",
            "start_utterance_id",
            "end_utterance_id"
          ],
          "properties": {
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "start_utterance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "end_utterance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_revision",
            "base_plan_hash",
            "source_fingerprint",
            "title",
            "start_utterance_id",
            "end_utterance_id"
          ],
          "properties": {
            "base_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "base_plan_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "start_utterance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "end_utterance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          }
        }
      ]
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "CREATE"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_fingerprint",
              "title",
              "start_utterance_id",
              "end_utterance_id"
            ],
            "properties": {
              "source_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "start_utterance_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "end_utterance_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            }
          },
          "revision": {
            "const": 1
          }
        }
      },
      "else": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_revision",
              "base_plan_hash",
              "source_fingerprint",
              "title",
              "start_utterance_id",
              "end_utterance_id"
            ],
            "properties": {
              "base_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "base_plan_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "start_utterance_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "end_utterance_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ]
}
