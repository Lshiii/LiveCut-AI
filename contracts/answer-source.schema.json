{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livecut:answer-source:1.0",
  "title": "Frozen verified video-answer anchors for a single clip target",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "turn_id", "session_id", "answer_hash", "job_id", "video_id", "source_hash", "transcript_hash", "duration_ms", "question", "answer", "utterance_ids", "citations", "context_utterance_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "turn_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "answer_hash": {"$ref": "#/$defs/hash"},
    "job_id": {"type": "string", "format": "uuid"},
    "video_id": {"type": "string", "format": "uuid"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "transcript_hash": {"$ref": "#/$defs/hash"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "answer": {"type": "string", "minLength": 1, "maxLength": 6000},
    "utterance_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "citations": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["utterance_id", "start_ms", "end_ms", "text"],
        "properties": {
          "utterance_id": {"$ref": "#/$defs/id"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 12000}
        }
      }
    },
    "context_utterance_ids": {"type": "array", "minItems": 1, "maxItems": 72, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
