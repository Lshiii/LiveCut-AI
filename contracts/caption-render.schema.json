{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livecut.local/contracts/caption-render.schema.json",
  "title": "Independent caption-render public snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_export_id",
    "source_clip_id",
    "job_id",
    "caption_revision",
    "caption_content_hash",
    "source_clip_sha256",
    "style_preset",
    "frame_preset",
    "profile_version",
    "font_profile",
    "status",
    "state_version",
    "attempt",
    "created_at",
    "updated_at",
    "error_code",
    "diagnostic",
    "actions",
    "progress",
    "content_url",
    "download_url",
    "size_bytes",
    "media"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source_export_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_clip_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "caption_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "caption_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_clip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "style_preset": {
      "enum": [
        "WHITE_OUTLINE_V1",
        "DARK_BOX_V1"
      ]
    },
    "frame_preset": {
      "enum": [
        "SOURCE",
        "LANDSCAPE_720",
        "PORTRAIT_720",
        "PORTRAIT_BLUR_720"
      ]
    },
    "profile_version": {
      "const": "caption-burn-v1"
    },
    "font_profile": {
      "const": "noto-sans-cjk-sc-2.004"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
        }
      ]
    },
    "diagnostic": {
      "type": [
        "object",
        "null"
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_cancel",
        "can_retry",
        "max_attempts",
        "retry_block_reason"
      ],
      "properties": {
        "can_cancel": {
          "type": "boolean"
        },
        "can_retry": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retry_block_reason": {
          "enum": [
            null,
            "NOT_FAILED",
            "ATTEMPTS_EXHAUSTED",
            "CANCELLED_REQUIRES_NEW_RENDER",
            "INPUT_REQUIRES_NEW_RENDER"
          ]
        }
      }
    },
    "progress": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "processed_ms",
            "total_ms",
            "updated_at"
          ],
          "properties": {
            "phase": {
              "enum": [
                "PREPARING",
                "ENCODING",
                "VALIDATING",
                "PUBLISHING"
              ]
            },
            "processed_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "content_url": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^/api/caption-renders/[a-f0-9-]{36}/content$"
        }
      ]
    },
    "download_url": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^/api/caption-renders/[a-f0-9-]{36}/content\\?download=true$"
        }
      ]
    },
    "size_bytes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ]
    },
    "media": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_ms",
            "width",
            "height"
          ],
          "properties": {
            "duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "content_url": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duration_ms",
              "width",
              "height"
            ],
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "content_url": {
            "type": "null"
          },
          "download_url": {
            "type": "null"
          },
          "size_bytes": {
            "type": "null"
          },
          "media": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frame_preset": {
            "enum": [
              "LANDSCAPE_720"
            ]
          },
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "media": {
            "properties": {
              "width": {
                "const": 1280
              },
              "height": {
                "const": 720
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "frame_preset": {
            "enum": [
              "PORTRAIT_720",
              "PORTRAIT_BLUR_720"
            ]
          },
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "media": {
            "properties": {
              "width": {
                "const": 720
              },
              "height": {
                "const": 1280
              }
            }
          }
        }
      }
    }
  ]
}
