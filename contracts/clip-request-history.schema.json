{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livecut:clip-request-history:1.0",
  "title": "Read-only bounded clip request history metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "items", "limit", "next_cursor", "active_count"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"$ref": "#/$defs/uuid"},
    "items": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/summary"}},
    "limit": {"type": "integer", "minimum": 1, "maximum": 30},
    "next_cursor": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+$"}]},
    "active_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "job_id", "video_id", "instruction", "status", "state_version", "created_at", "updated_at", "budget", "source", "revision", "plan_hash", "source_mode"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "job_id": {"$ref": "#/$defs/uuid"},
        "video_id": {"$ref": "#/$defs/uuid"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"enum": ["QUEUED", "RUNNING", "PLAN_READY", "FAILED", "CANCELLED"]},
        "state_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "created_at": {"$ref": "#/$defs/instant"},
        "updated_at": {"$ref": "#/$defs/instant"},
        "budget": {
          "type": "object", "additionalProperties": false, "required": ["max_text_calls", "text_calls_reserved"],
          "properties": {"max_text_calls": {"type": "integer", "minimum": 1, "maximum": 24}, "text_calls_reserved": {"type": "integer", "minimum": 0, "maximum": 24}}
        },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["video_sha256", "transcript_hash", "duration_ms"],
          "properties": {"video_sha256": {"$ref": "#/$defs/hash"}, "transcript_hash": {"$ref": "#/$defs/hash"}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
        },
        "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "plan_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "source_mode": {"enum": ["INSTRUCTION", "ANSWER_CITATIONS"]}
      }
    }
  }
}
