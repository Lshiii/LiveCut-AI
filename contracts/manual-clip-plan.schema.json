{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livecut:manual-clip-plan:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "source_kind",
    "id",
    "source",
    "revision",
    "latest_revision",
    "plan_hash",
    "status",
    "confirmed_revisions",
    "created_at",
    "updated_at",
    "title",
    "start_utterance_id",
    "end_utterance_id",
    "range"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_kind": {
      "const": "manual_clip_plan"
    },
    "source_kind": {
      "const": "MANUAL_ASR"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "latest_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "CONFIRMED"
      ]
    },
    "confirmed_revisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "start_utterance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "end_utterance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "range": {
      "$ref": "#/$defs/range"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "video_id",
        "generation",
        "source_video_sha256",
        "transcript_sha256",
        "analysis_sha256",
        "duration_ms",
        "source_fingerprint"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "video_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_video_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysis_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms",
        "utterance_count",
        "start_text",
        "end_text"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "utterance_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "start_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "end_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      }
    }
  }
}
