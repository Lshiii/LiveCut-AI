{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livecut.local/contracts/caption-render-cues.schema.json",
  "title": "Confirmed plain-text clip-relative render cues v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "duration_ms",
    "cues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
