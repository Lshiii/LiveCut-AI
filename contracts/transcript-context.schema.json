{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livecut.local/contracts/transcript-context.schema.json",
  "title": "Published original ASR transcript context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "source",
    "center",
    "previous",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_kind": {
      "const": "transcript_context"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "center": {
      "$ref": "#/$defs/utterance"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/utterance"
        },
        {
          "type": "null"
        }
      ]
    },
    "next": {
      "anyOf": [
        {
          "$ref": "#/$defs/utterance"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "video_id",
        "generation",
        "source_video_sha256",
        "transcript_sha256",
        "analysis_sha256",
        "duration_ms",
        "source_fingerprint"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "video_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_video_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysis_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utterance_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "properties": {
        "utterance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      }
    }
  }
}
