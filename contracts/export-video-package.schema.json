{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:livecut:export-video-package:1.0",
  "title": "Verified selected clean MP4 delivery package manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "data_kind", "export_id", "job_id", "video_id", "source_video_sha256", "approved_revision", "snapshot_hash", "profile", "render_mode", "clip_request_id", "clips", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "data_kind": {"const": "export_video_package"},
    "export_id": {"$ref": "#/$defs/uuid"}, "job_id": {"$ref": "#/$defs/uuid"}, "video_id": {"$ref": "#/$defs/uuid"},
    "source_video_sha256": {"$ref": "#/$defs/hash"}, "snapshot_hash": {"$ref": "#/$defs/hash"},
    "approved_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "profile": {"type": "string", "minLength": 1, "maxLength": 128}, "render_mode": {"const": "CLEAN"},
    "clip_request_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]},
    "manual_clip_plan_id": {"$ref": "#/$defs/uuid"},
    "clips": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/clip"}},
    "files": {"type": "array", "minItems": 2, "maxItems": 101, "items": {"$ref": "#/$defs/indexFile"}}
  },
  "allOf": [{"if": {"required": ["manual_clip_plan_id"]}, "then": {"properties": {"clip_request_id": {"type": "null"}, "approved_revision": {"minimum": 1}}}}],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "videoPath": {"type": "string", "pattern": "^clips/[0-9]{3}-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\\.mp4$"},
    "part": {"type": "object", "additionalProperties": false, "required": ["start_ms", "end_ms"], "properties": {"start_ms": {"$ref": "#/$defs/ms"}, "end_ms": {"$ref": "#/$defs/positive"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/videoPath"}, "size_bytes": {"$ref": "#/$defs/positive"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["clip_id", "segment_id", "title", "start_ms", "end_ms", "duration_ms", "parts", "file"],
      "properties": {
        "clip_id": {"$ref": "#/$defs/uuid"}, "segment_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 2000}]},
        "start_ms": {"$ref": "#/$defs/ms"}, "end_ms": {"$ref": "#/$defs/positive"}, "duration_ms": {"$ref": "#/$defs/positive"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/part"}}, "file": {"$ref": "#/$defs/file"}
      }
    },
    "indexFile": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "content_type"], "properties": {
      "path": {"oneOf": [{"const": "README.txt"}, {"$ref": "#/$defs/videoPath"}]}, "size_bytes": {"$ref": "#/$defs/positive"},
      "sha256": {"$ref": "#/$defs/hash"}, "content_type": {"enum": ["video/mp4", "text/plain; charset=UTF-8"]}
    }}
  }
}
