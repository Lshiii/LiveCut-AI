# Literal NAME=value; do not wrap values in shell quotes. Copy to .env.java.
LIVECUT_DB_URL=jdbc:mysql://127.0.0.1:13306/livecut_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LIVECUT_DB_USER=livecut
LIVECUT_DB_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
LIVECUT_STORAGE_ROOT=../storage
LIVECUT_WORKER_API_KEY=REPLACE_WITH_RANDOM_LOCAL_WORKER_KEY
LIVECUT_API_PORT=8080

# Optional absolute executable paths if FFmpeg is not on PATH.
# LIVECUT_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# LIVECUT_FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# Optional resumable-upload limits. Each active file reserves 3x its size for temporary copies.
# LIVECUT_UPLOAD_CHUNK_SIZE=8388608
# LIVECUT_UPLOAD_MAX_ACTIVE=8
# LIVECUT_UPLOAD_MAX_RESERVED_BYTES=4294967296
# LIVECUT_UPLOAD_RECEIVE_SLOTS=6
# LIVECUT_UPLOAD_MERGE_SLOTS=1
# LIVECUT_UPLOAD_TTL_SECONDS=86400
# LIVECUT_UPLOAD_LEASE_SECONDS=90
