# Literal NAME=value; do not wrap values in shell quotes. Copy to .env.java.
LIVECUT_DB_URL=jdbc:mysql://127.0.0.1:13306/livecut_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LIVECUT_DB_USER=livecut
LIVECUT_DB_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
LIVECUT_STORAGE_ROOT=../storage
LIVECUT_WORKER_API_KEY=REPLACE_WITH_RANDOM_LOCAL_WORKER_KEY
LIVECUT_API_PORT=8080

# Stage dispatch: start the Kafka Compose profile before selecting kafka here.
# Existing deployments may retain poll while upgrading Java and Worker.
LIVECUT_DISPATCH_MODE=kafka
LIVECUT_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
LIVECUT_KAFKA_TOPIC=livecut.stage-wakeup.v1
# Only a low-frequency recovery probe when notifications were missed.
LIVECUT_KAFKA_RECONCILE_SECONDS=60

# Optional absolute executable paths if FFmpeg is not on PATH.
# LIVECUT_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# LIVECUT_FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# Optional resumable-upload limits. Each active file reserves 3x its size for temporary copies.
# LIVECUT_UPLOAD_CHUNK_SIZE=8388608
# LIVECUT_UPLOAD_MAX_ACTIVE=8
# LIVECUT_UPLOAD_MAX_RESERVED_BYTES=4294967296
# LIVECUT_UPLOAD_RECEIVE_SLOTS=6
# LIVECUT_UPLOAD_MERGE_SLOTS=1
# LIVECUT_UPLOAD_TTL_SECONDS=86400
# LIVECUT_UPLOAD_LEASE_SECONDS=90

# Optional current-state SSE stream limits; each resource shares one polling read.
# LIVECUT_EVENTS_POLL_MS=1000
# LIVECUT_EVENTS_HEARTBEAT_MS=15000
# LIVECUT_EVENTS_TIMEOUT_MS=120000
# LIVECUT_EVENTS_MAX_CONNECTIONS=32
# LIVECUT_EVENTS_MAX_PER_RESOURCE=8
# LIVECUT_EVENTS_SENDER_THREADS=4
# LIVECUT_EVENTS_SENDER_QUEUE=32

# Executor presence and active-stage capacity. Java and Worker must be upgraded together.
# LIVECUT_WORKER_HEARTBEAT_TIMEOUT_SECONDS=35
# LIVECUT_FFMPEG_SLOTS=1
# LIVECUT_ASR_SLOTS=2
# LIVECUT_TEXT_SLOTS=2

# Optional text provider (ASR continues using its own DashScope credential).
# LIVECUT_TEXT_MODEL=deepseek-flash
# LIVECUT_TEXT_API_STYLE=openai
# LIVECUT_TEXT_BASE_URL=https://api.deepseek.com
# LIVECUT_TEXT_API_KEY=REPLACE_WITH_TEXT_PROVIDER_KEY
# LIVECUT_TEXT_MAX_ATTEMPTS=3
# LIVECUT_TEXT_ATTEMPT_TIMEOUT_SECONDS=90
# LIVECUT_TEXT_TOTAL_TIMEOUT_SECONDS=240
# LIVECUT_TEXT_RETRY_BACKOFF_SECONDS=1
# Fallback names are frozen for newly created requests, not retrofitted to old ones.
# LIVECUT_TEXT_FALLBACK_MODELS=qwen-plus
# LIVECUT_TEXT_FALLBACK_API_KEY=REPLACE_WITH_BACKUP_TEXT_KEY
# LIVECUT_TEXT_FALLBACKS_JSON=[{"name":"bailian","base_url":"https://dashscope.aliyuncs.com","api_style":"dashscope","model":"qwen-plus","key_env":"LIVECUT_TEXT_FALLBACK_API_KEY"}]

# Optional explicit sampled-frame Agent. Empty/unset leaves visual mode disabled.
# Java freezes this model for each new frames turn; Worker needs the matching configuration.
# All visual chat/completions count toward the turn's max_text_calls. No text fallback.
# LIVECUT_AGENT_VISUAL_MODEL=deepseek-flash
# Worker-only OpenAI-compatible base URL and credential; configure for your account/region.
# LIVECUT_AGENT_VISUAL_BASE_URL=https://api.deepseek.com
# LIVECUT_AGENT_VISUAL_API_KEY=REPLACE_WITH_VISUAL_PROVIDER_KEY
# Alternative: qwen3-vl-plus with https://dashscope.aliyuncs.com/compatible-mode/v1
# Use that provider's own credential and available quota; changing keys does not reset quota.

# Optional local CPU semantic retrieval for intent clip requests (Worker only).
# Prepare explicitly with scripts/prepare-intent-embedding.py; unset means BM25.
# LIVECUT_INTENT_EMBEDDING_DIR=C:/path/to/LiveCut-AI/data/models/intent-bge-small

# Confirmed caption material packages: disk streaming, shared temporary quota.
# LIVECUT_CAPTION_PACKAGE_MAX_BYTES=2147483648
# LIVECUT_CAPTION_PACKAGE_SLOTS=2
# LIVECUT_CAPTION_PACKAGE_TEMPORARY_QUOTA=4294967296
# LIVECUT_CAPTION_PACKAGE_BUILD_SECONDS=180

# Install once: python scripts/install-caption-font.py (run from repo root).
# Set the absolute path returned by that command when using caption MP4 rendering.
# LIVECUT_CAPTION_FONT_PATH=C:/work/LiveCut-AI/data/fonts/noto-sans-cjk-sc-2.004/NotoSansCJKsc-Regular.otf
