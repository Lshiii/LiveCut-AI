# Copy to private .env.mysql-local and fill absolute paths for YOUR installation.
# Existing initialized independent datadir only; its basename must start livecut-mysql-.
# Prefer an ASCII path on Windows/MySQL 8.0. This example is not created automatically.
LIVECUT_MYSQLD_PATH=D:/MySQL/MySQL Server 8.0/bin/mysqld.exe
LIVECUT_MYSQL_DATADIR=C:/livecut-local/livecut-mysql-local
LIVECUT_MYSQL_PORT=13306
LIVECUT_MYSQL_USER=root
LIVECUT_MYSQL_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD

# Alternative for an already-existing private file containing ONLY MYSQL_PWD=...
# Remove LIVECUT_MYSQL_PASSWORD above when using this option. No shell evaluation.
# LIVECUT_MYSQL_CREDENTIALS_FILE=.env.mysql-dev
